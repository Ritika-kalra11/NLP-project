# ========================================================
# ResearchAI Environment Configuration
# ========================================================

# Server Configuration
RESEARCHAI_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Mode (true enables deterministic, grounded RAG without needing an external API key)
DEMO_MODE=true

# LLM Configuration (OpenAI, Groq, Local vLLM/Ollama/LM Studio compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_TOKENS=2048

# Embedding & Vector Database
EMBEDDING_PROVIDER=sentence-transformers # options: sentence-transformers, openai, local-tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_DIR=../data/vector_db

# Storage & Database
DATABASE_URL=sqlite:///../data/researchai.db
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE_MB=50

# RAG Hyperparameters
TOP_K=5
SIMILARITY_THRESHOLD=0.30
CHUNK_SIZE=600
CHUNK_OVERLAP=100
USE_HYBRID_SEARCH=true
USE_RERANKING=true
